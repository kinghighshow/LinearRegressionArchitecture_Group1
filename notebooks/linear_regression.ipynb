   "source": [
    "# Explicit training settings, following the professor's loop structure.\n",
    "lr = 0.01\n",
    "epochs = 2000\n",
    "\n",
    "# Start with zero slope and zero intercept.\n",
    "w_gd, b_gd = 0.0, 0.0\n",
    "loss_history = []\n",
    "\n",
    "# Calculate the starting error before any parameter updates.\n",
    "initial_mse_gd = mean_squared_error(\n",
    "    workshop_y,\n",
    "    w_gd * workshop_x + b_gd,\n",
    ")\n",
    "\n",
    "for epoch in range(epochs):\n",
    "    # Predict using the current parameters.\n",
    "    y_hat = w_gd * workshop_x + b_gd\n",
    "\n",
    "    # Calculate BOTH gradients before updating either parameter.\n",
    "    grad_w = (-2 / workshop_n) * np.sum(\n",
    "        (workshop_y - y_hat) * workshop_x\n",
    "    )\n",
    "    grad_b = (-2 / workshop_n) * np.sum(\n",
    "        workshop_y - y_hat\n",
    "    )\n",
    "\n",
    "    # Update the slope and intercept.\n",
    "    w_gd -= lr * grad_w\n",
    "    b_gd -= lr * grad_b\n",
    "\n",
    "    # Recalculate predictions so the loss matches the updated parameters.\n",
    "    updated_prediction = w_gd * workshop_x + b_gd\n",
    "\n",
    "    if not np.all(np.isfinite(updated_prediction)):\n",
    "        raise ValueError(\n",
    "            \"Training diverged. Review the learning rate and input data.\"\n",
    "        )\n",
    "\n",
    "    current_mse = mean_squared_error(\n",
    "        workshop_y,\n",
    "        updated_prediction,\n",
    "    )\n",
    "    loss_history.append(current_mse)\n",
    "\n",
    "# Convert the coefficients to the original median-income scale.\n",
    "w_gd_original = w_gd / scaler.scale_[0]\n",
    "b_gd_original = (\n",
    "    b_gd - w_gd * scaler.mean_[0] / scaler.scale_[0]\n",
    ")\n",
    "\n",
    "print(\"GRADIENT DESCENT — TRAINING RESULTS\")\n",
    "print(f\"Training observations: {workshop_n:,}\")\n",
    "print(f\"Learning rate: {lr}\")\n",
    "print(f\"Epochs completed: {len(loss_history):,}\")\n",
    "\n",
    "print(\"\\nParameters for STANDARDIZED median income:\")\n",
    "print(f\"Slope (w): {w_gd:,.4f}\")\n",
    "print(f\"Intercept (b): {b_gd:,.4f}\")\n",
    "\n",
    "print(\"\\nParameters for ORIGINAL median income scale:\")\n",
    "print(f\"Slope: {w_gd_original:,.4f}\")\n",
    "print(f\"Intercept: {b_gd_original:,.4f}\")\n",
    "\n",
    "print(\"\\nTraining error:\")\n",
    "print(f\"Initial MSE: {initial_mse_gd:,.2f}\")\n",
    "print(f\"Final MSE: {loss_history[-1]:,.2f}\")\n",
    "print(f\"Normal Equation MSE: {workshop_mse_ne:,.2f}\")\n",
    "print(\"MSE units: squared median-house-value units\")"
   ]
