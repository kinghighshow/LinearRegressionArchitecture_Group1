    "# New predictor value in the CSV's original median-income scale.\n",
    "new_income = 5.0\n",
    "\n",
    "# Check whether the input is within the observed training range.\n",
    "training_income_min = float(X_train[FEATURE].min())\n",
    "training_income_max = float(X_train[FEATURE].max())\n",
    "\n",
    "within_training_range = (\n",
    "    training_income_min <= new_income <= training_income_max\n",
    ")\n",
    "\n",
    "# Preserve the same feature name used when fitting the scaler.\n",
    "new_income_frame = pd.DataFrame({\n",
    "    FEATURE: [new_income],\n",
    "})\n",
    "\n",
    "# Apply the existing training transformation without fitting again.\n",
    "new_income_scaled = float(\n",
    "    scaler.transform(new_income_frame)[0, 0]\n",
    ")\n",
    "\n",
    "# Predict using the Normal Equation model.\n",
    "pred_value_ne = w_hat * new_income_scaled + b_hat\n",
    "\n",
    "# Predict using the gradient-descent model.\n",
    "pred_value_gd = w_gd * new_income_scaled + b_gd\n",
    "\n",
    "print(\"NEW MEDIAN HOUSE VALUE PREDICTION\")\n",
    "print(f\"Median income input (original dataset scale): {new_income:.2f}\")\n",
    "print(f\"Within observed training income range: {within_training_range}\")\n",
    "\n",
    "if not within_training_range:\n",
    "    print(\"Warning: this prediction extrapolates beyond the training range.\")\n",
    "\n",
    "print(\"\\nPredicted median house value:\")\n",
    "print(f\"Normal Equation: {pred_value_ne:,.2f}\")\n",
    "print(f\"Gradient descent: {pred_value_gd:,.2f}\")\n",
    "print(\"Prediction units: original median-house-value units\")\n",
    "\n",
    "print(\"\\nAbsolute difference between model predictions:\")\n",
    "print(f\"{abs(pred_value_ne - pred_value_gd):.3e} target units\")"
