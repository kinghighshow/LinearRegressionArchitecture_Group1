    "    f\"{X_train_scaled.mean():.6f}\"\n",
    ")\n",
    "print(\n",
    "    f\"Training predictor std after scaling: \"\n",
    "    f\"{X_train_scaled.std():.6f}\"\n",
    ")\n",
    "print(f\"Training input shape: {X_train_scaled.shape}\")\n",
    "print(f\"Test input shape: {X_test_scaled.shape}\")"
