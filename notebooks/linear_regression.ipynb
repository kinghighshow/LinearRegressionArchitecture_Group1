   "source": [
    "# Use the existing training data and training-only standardization.\n",
    "# Flatten both arrays to keep one predictor and one target per observation.\n",
    "workshop_x = np.asarray(X_train_scaled, dtype=float).reshape(-1)\n",
    "workshop_y = np.asarray(y_train, dtype=float).reshape(-1)\n",
    "workshop_n = len(workshop_y)\n",
    "\n",
    "# Follow the professor's column order: predictor first, intercept second.\n",
    "X_design = np.vstack([\n",
    "    workshop_x,\n",
    "    np.ones(workshop_n),\n",
    "]).T\n",
    "\n",
    "# The matrix inverse requires two linearly independent columns.\n",
    "if np.linalg.matrix_rank(X_design) < 2:\n",
    "    raise ValueError(\n",
    "        \"The Normal Equation requires a nonconstant predictor.\"\n",
    "    )\n",
    "\n",
    "# Analytical least-squares solution, following the professor's formula.\n",
    "theta = (\n",
    "    np.linalg.inv(X_design.T @ X_design)\n",
    "    @ X_design.T\n",
    "    @ workshop_y\n",
    ")\n",
    "\n",
    "w_hat, b_hat = theta\n",
    "\n",
    "# Express the same fitted line in the original income scale.\n",
    "w_hat_original = w_hat / scaler.scale_[0]\n",
    "b_hat_original = (\n",
    "    b_hat - w_hat * scaler.mean_[0] / scaler.scale_[0]\n",
    ")\n",
    "\n",
    "# Report coefficients with explicit labels to avoid mixing scales.\n",
    "print(\"NORMAL EQUATION — TRAINING DATA\")\n",
    "print(f\"Training observations: {workshop_n:,}\")\n",
    "print(f\"Design matrix shape: {X_design.shape}\")\n",
    "\n",
    "print(\"\\nParameters for STANDARDIZED median income:\")\n",
    "print(f\"Slope (w): {w_hat:,.4f}\")\n",
    "print(f\"Intercept (b): {b_hat:,.4f}\")\n",
    "\n",
    "print(\"\\nParameters for ORIGINAL median income scale:\")\n",
    "print(f\"Slope: {w_hat_original:,.4f}\")\n",
    "print(f\"Intercept: {b_hat_original:,.4f}\")\n",
    "\n",
    "print(\"\\nPrediction equation using original median income:\")\n",
    "print(\n",
    "    f\"Predicted median house value = \"\n",
    "    f\"{w_hat_original:,.4f} × median_income \"\n",
    "    f\"+ {b_hat_original:,.4f}\"\n",
    ")"
   ]
